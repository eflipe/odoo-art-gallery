<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="art_gallery.DashboardTsTemplate">
        <div class="o_content container-fluid p-4" style="height: 100%; overflow-y: auto;">
            <h1 class="mb-4">Art Gallery Dashboard (TypeScript)</h1>
            
            <!-- Barra de Filtros -->
            <div class="card mb-3 bg-light">
                <div class="card-body d-flex align-items-end gap-3 flex-wrap">
                    <div>
                        <label class="form-label" for="yearFrom">Año desde</label>
                        <input type="text" class="form-control" id="yearFrom" 
                            t-model="state.yearFrom" 
                            placeholder="Ej. 1800"/>
                    </div>
                    <div>
                        <label class="form-label" for="yearTo">Año hasta</label>
                        <input type="text" class="form-control" id="yearTo" 
                            t-model="state.yearTo" 
                            placeholder="Ej. 1900"/>
                    </div>
                    <div class="mb-1">
                        <button class="btn btn-primary me-2" t-on-click="onApplyFilter" t-att-disabled="state.isLoading">
                            <t t-if="state.isLoading">Buscando...</t>
                            <t t-else="">Filtrar</t>
                        </button>
                        <button class="btn btn-secondary" t-on-click="onClearFilter" t-att-disabled="state.isLoading">
                            Limpiar
                        </button>
                    </div>
                </div>
            </div>

            <!-- Alerta de Error -->
            <div t-if="state.errorMsg" class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                <i class="fa fa-exclamation-triangle me-2"/>
                <div>
                    <strong>Error:</strong> <t t-esc="state.errorMsg"/>
                    <br/>
                    <small>Por favor, introduce años válidos (números enteros positivos).</small>
                </div>
            </div>

            <!-- Contador de Resultados -->
            <div t-if="!state.isLoading and !state.errorMsg" class="mb-3 text-muted">
                Se encontraron <strong><t t-esc="state.artworks.length"/></strong> obras.
            </div>

            <!-- Lista de Obras -->
            <div class="row">
                <!-- Si no hay obras -->
                <div t-if="!state.isLoading and !state.errorMsg and state.artworks.length === 0" class="col-12 text-center py-5">
                    <h4 class="text-muted">No se encontraron obras para este filtro.</h4>
                </div>

                <!-- Tarjetas de Obras -->
                <t t-foreach="state.artworks" t-as="artwork" t-key="artwork.id">
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-sm">
                            <div style="height: 250px; background-color: #f8f9fa; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                <img t-if="artwork.image"
                                     t-att-src="'data:image/png;base64,' + artwork.image"
                                     class="img-fluid"
                                     style="max-height: 100%; max-width: 100%; object-fit: contain;"/>
                                <div t-else="" class="text-muted">
                                    <i class="fa fa-picture-o fa-3x mb-2"/>
                                    <p>Sin imagen</p>
                                </div>
                            </div>
                            <div class="card-body">
                                <h5 class="card-title" t-esc="artwork.name"/>
                                <p class="card-text text-muted" t-esc="artwork.artist_name"/>
                                <p class="card-text" t-if="artwork.year">
                                    <small class="text-body-secondary">Año: <t t-esc="artwork.year"/></small>
                                </p>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>