<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view -->
    <record id="view_artwork_tree" model="ir.ui.view">
        <field name="name">art_gallery.artwork.tree</field>
        <field name="model">art_gallery.artwork</field>
        <field name="arch" type="xml">
        <list string="Artworks" default_order="year">
            <header>
            <button name="action_import_artworks"
                        type="object"
                        string="Import from API"
                        class="oe_highlight"
                        display="always"/>
            <button name="%(action_import_artworks_wizard)d"
                        type="action"
                        string="Wizard Import by Year"
                        class="oe_highlight"
                        display="always"/>
            </header>
            <field name="name"/>
            <field name="artist_name"/>
            <field name="year"/>
        </list>
        </field>
    </record>

    <record id="view_artwork_kanban" model="ir.ui.view">
        <field name="name">art_gallery.artwork.kanban</field>
        <field name="model">art_gallery.artwork</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_gallery" default_order="year">
                <field name="id"/>
                <field name="name"/>
                <field name="artist_name"/>
                <field name="year"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <field name="image" widget="image" class="o_kanban_image"/>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted">
                                    <field name="artist_name"/>
                                </div>
                                <div class="text-muted">
                                    <field name="year"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_artwork_form" model="ir.ui.view">
        <field name="name">art_gallery.artwork.form</field>
        <field name="model">art_gallery.artwork</field>
        <field name="arch" type="xml">
        <form string="Artwork">
            <sheet>
                <field name="image" widget="image" class="oe_avatar"/>
                <group>
                    <field name="name"/>
                    <field name="artist_name"/>
                    <field name="external_id"/>
                </group>
                <group>
                    <field name="description"/>
                    <field name="image_url" widget="url"/>
                </group>
            </sheet>
        </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_artwork_search" model="ir.ui.view">
        <field name="name">art_gallery.artwork.search</field>
        <field name="model">art_gallery.artwork</field>
        <field name="arch" type="xml">
            <search string="Search Artworks">
                <field name="name"/>
                <field name="artist_name"/>
            </search>
        </field>
    </record>

    <record id="action_server_import_artworks" model="ir.actions.server">
        <field name="name">Import Artworks from API</field>
        <field name="model_id" ref="model_art_gallery_artwork"/>
        <field name="binding_model_id" ref="model_art_gallery_artwork"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">model.action_import_artworks()</field>
    </record>

    <!-- Action -->
    <record id="action_artwork" model="ir.actions.act_window">
        <field name="name">Artworks</field>
        <field name="res_model">art_gallery.artwork</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>