<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_artist_list" model="ir.ui.view">
        <field name="name">art_gallery.artist.list</field>
        <field name="model">art_gallery.artist</field>
        <field name="arch" type="xml">
            <list string="Artists">
                <field name="name"/>
                <field name="email"/>
                <field name="partner_id"/>
                <field name="commission_percentage"/>
                <field name="artwork_count"/>
            </list>
        </field>
    </record>

    <record id="view_artist_search" model="ir.ui.view">
        <field name="name">art_gallery.artist.search</field>
        <field name="model">art_gallery.artist</field>
        <field name="arch" type="xml">
            <search string="Search Artists">
                <field name="name"/>
                <filter
                    string="More than 5 Artworks"
                    name="many_artworks"
                    domain="[('artwork_count', '&gt;', 5)]"
                />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="view_artist_form" model="ir.ui.view">
        <field name="name">art_gallery.artist.form</field>
        <field name="model">art_gallery.artist</field>
        <field name="arch" type="xml">
            <form string="Artist">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_artworks"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-picture-o"
                        >
                            <field
                                name="artwork_count"
                                widget="statinfo"
                                string="Artworks"
                            />
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="commission_percentage"/>
                        <field name="biography"/>
                    </group>
                    <notebook>
                        <page string="Artworks" name="artworks">
                            <field name="artwork_ids">
                                <list delete="0" open_form_view="True">
                                    <field name="name" string="Title"/>
                                    <field name="year"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_artist" model="ir.actions.act_window">
        <field name="name">Artists</field>
        <field name="res_model">art_gallery.artist</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_artist_search"/>
    </record>
</odoo>
