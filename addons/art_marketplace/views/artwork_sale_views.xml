<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_art_marketplace_artwork_sale_list" model="ir.ui.view">
        <field name="name">art_marketplace.artwork_sale.list</field>
        <field name="model">art_marketplace.artwork_sale</field>
        <field name="arch" type="xml">
            <list>
                <field name="artwork_id"/>
                <field name="price"/>
                <field name="seller_id"/>
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'published'"
                    decoration-muted="state == 'sold'"
                />
            </list>
        </field>
    </record>

    <record id="view_art_marketplace_artwork_sale_form" model="ir.ui.view">
        <field name="name">art_marketplace.artwork_sale.form</field>
        <field name="model">art_marketplace.artwork_sale</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_publish"
                        string="Publicar"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_sell"
                        string="Vender"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'published'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,sold"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="artwork_id"/>
                            <field name="price"/>
                            <field name="seller_id"/>
                        </group>
                        <group>
                            <field name="state" invisible="1"/>
                            <field name="buyer_id"/>
                            <field name="sale_date"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_art_marketplace_artwork_sale_search" model="ir.ui.view">
        <field name="name">art_marketplace.artwork_sale.search</field>
        <field name="model">art_marketplace.artwork_sale</field>
        <field name="arch" type="xml">
            <search>
                <field name="artwork_id"/>
                <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Published" name="state_published" domain="[('state', '=', 'published')]"/>
                <filter string="Sold" name="state_sold" domain="[('state', '=', 'sold')]"/>
            </search>
        </field>
    </record>

    <record id="action_art_marketplace_artwork_sale" model="ir.actions.act_window">
        <field name="name">Artwork Sales</field>
        <field name="res_model">art_marketplace.artwork_sale</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_art_marketplace_artwork_sale_search"/>
    </record>
</odoo>
