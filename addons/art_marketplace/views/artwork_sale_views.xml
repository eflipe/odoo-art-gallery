<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_art_marketplace_artwork_sale_list" model="ir.ui.view">
        <field name="name">art_marketplace.artwork_sale.list</field>
        <field name="model">art_marketplace.artwork_sale</field>
        <field name="arch" type="xml">
            <list>
                <field name="artwork_id"/>
                <field name="price"/>
                <field name="seller_id"/>
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'published'"
                    decoration-muted="state == 'sold'"
                />
            </list>
        </field>
    </record>

    <record id="view_art_marketplace_artwork_sale_form" model="ir.ui.view">
        <field name="name">art_marketplace.artwork_sale.form</field>
        <field name="model">art_marketplace.artwork_sale</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_publish"
                        string="Publicar"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_open_sell_wizard"
                        string="Vender"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'published'"
                    />
                    <button
                        name="action_reset_to_published"
                        string="Cancel Sale"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'sold'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,sold"/>
                </header>
                <sheet>

                    <field name="unavailable_artwork_ids" invisible="1"/>

                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_purchase_requests"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-ticket"
                            invisible="purchase_request_count == 0"
                        >
                            <field name="purchase_request_count" widget="statinfo" string="Tickets"/>
                        </button>
                    </div>

                    <!-- NUEVA ALERTA VERDE -->
                    <div class="alert alert-success d-flex align-items-center mt-3 mb-0" 
                         role="alert" 
                         style="border-radius: 5px;"
                         invisible="purchase_request_count == 0 or state == 'sold'">
                        <i class="fa fa-info-circle fa-2x me-3"/>
                        <div>
                            <strong>¡Atención!</strong> Existen 
                            <field name="purchase_request_count" readonly="1" class="fw-bold d-inline"/> 
                            ticket(s) de compra para esta obra. 
                            Revisa los <strong>Purchase Requests</strong> antes de confirmar la venta.
                        </div>
                    </div>

                    <!-- Contenedor principal con flex -->
                    <div class="d-flex w-100">
                        
                        <!-- Columna Izquierda: Datos de la venta (40%) -->
                        <div class="w-40 pe-4" style="width: 40%;">
                            <group>
                                <field name="artist_id" options="{'no_create': True}"/>
                                <field
                                    name="artwork_id"
                                    string="Select Artwork"
                                    domain="[
                                        ('artist_id', '=', artist_id),
                                        ('id', 'not in', unavailable_artwork_ids)
                                    ]"
                                    options="{'no_create': True}"
                                />
                                <field name="description" placeholder="Notas sobre el estado de la obra, procedencia, etc."/>
                            </group>
                            <group>
                                <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="currency_id" options="{'no_create': True}"/>
                            </group>
                            <group string="Distribución de la Venta">
                                <field name="artist_commission_percentage"/>
                                <field
                                    name="artist_commission_amount"
                                    widget="monetary"
                                    options="{'currency_field': 'currency_id'}"
                                />
                                <field
                                    name="gallery_net_income"
                                    widget="monetary"
                                    options="{'currency_field': 'currency_id'}"
                                />
                            </group>
                            <group string="Información de Venta">
                                <field name="seller_id" context="{'show_only_name': True}" domain="[('is_company', '=', False)]"/>
                                <field name="buyer_id" context="{'show_only_name': True}" domain="[('is_company', '=', False)]" invisible="state != 'sold'"/>
                                <field name="sale_date" invisible="state != 'sold'"/>
                                <field name="invoice_id" invisible="state != 'sold'" readonly="1"/>
                                <field name="artist_invoice_id" invisible="state != 'sold'" readonly="1"/>
                                <field name="state" invisible="1"/>
                            </group>
                        </div>

                        <!-- Columna Derecha: Imagen de la obra (60%) -->
                        <div class="d-flex justify-content-center align-items-start pt-2" style="width: 60%;">
                            <!-- Aumentamos el tamaño y añadimos una sombra suave -->
                            <field name="artwork_image" widget="image" readonly="1" class="shadow-sm border rounded" 
                                   options="{'size': [450, 450], 'preview_image': 'artwork_image'}"/>
                        </div>
                        
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_art_marketplace_artwork_sale_search" model="ir.ui.view">
        <field name="name">art_marketplace.artwork_sale.search</field>
        <field name="model">art_marketplace.artwork_sale</field>
        <field name="arch" type="xml">
            <search>
                <field name="artwork_id"/>
                <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Published" name="state_published" domain="[('state', '=', 'published')]"/>
                <filter string="Sold" name="state_sold" domain="[('state', '=', 'sold')]"/>
            </search>
        </field>
    </record>

    <record id="action_art_marketplace_artwork_sale" model="ir.actions.act_window">
        <field name="name">Artwork Sales</field>
        <field name="res_model">art_marketplace.artwork_sale</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_art_marketplace_artwork_sale_search"/>
    </record>
</odoo>
